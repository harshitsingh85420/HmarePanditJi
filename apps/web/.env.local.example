# ============================================================
# HmarePanditJi — Local Environment Variables (Web App)
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
# ============================================================

# ===== API =====
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ===== RAZORPAY (Payments) =====
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# ===== GOOGLE MAPS =====
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# ===== ANALYTICS =====
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id
NEXT_PUBLIC_GSC_VERIFICATION=your_gsc_verification_code

# ===== SENTRY (Error Monitoring) =====
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxxx

# ===== SUPPORT (ops contact, rendered on /help) =====
# LEAVE EMPTY unless a REAL, STAFFED number exists.
# /help renders an honest absence when this is empty, a placeholder, or not a
# dialable Indian number — it NEVER renders a dead tel: link. Do not put a
# plausible-looking stand-in here: a fallback shaped like a phone number is
# worse than no number, because nobody can tell by looking that it dials
# nothing. See packages/utils/src/support-contact.ts.
NEXT_PUBLIC_SUPPORT_PHONE=
# Free text, shown ONLY when a number is also set. Hours without a line to
# call is a promise with no subject. e.g. "Mon-Sat, 9am to 7pm"
NEXT_PUBLIC_SUPPORT_HOURS=

# ===== NODE ENV =====
NODE_ENV=development
