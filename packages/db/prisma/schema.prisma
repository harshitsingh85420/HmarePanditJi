generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  CUSTOMER
  PANDIT
  ADMIN
}

enum VerificationStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  VIDEO_KYC_DONE
  VERIFIED
  REJECTED
  APPROVED
}

enum BookingStatus {
  CREATED
  PANDIT_REQUESTED
  CONFIRMED
  TRAVEL_BOOKED
  PANDIT_EN_ROUTE
  PANDIT_ARRIVED
  PUJA_IN_PROGRESS
  COMPLETED
  CANCELLATION_REQUESTED
  CANCELLED
  REFUNDED
  REQUESTED
  ACCEPTED
  REJECTED
  IN_PROGRESS
}

enum TravelMode {
  SELF_DRIVE
  TRAIN
  FLIGHT
  CAB
  BUS
}

enum TravelStatus {
  NOT_REQUIRED
  PENDING
  ADMIN_CALCULATING
  BOOKED
  IN_TRANSIT
  ARRIVED
}

enum SamagriPreference {
  PANDIT_BRINGS
  CUSTOMER_ARRANGES
  NEED_HELP
}

enum FoodArrangement {
  CUSTOMER_PROVIDES
  PLATFORM_ALLOWANCE
}

enum AccommodationArrangement {
  NOT_NEEDED
  CUSTOMER_ARRANGES
  PLATFORM_BOOKS
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PAID
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PackageType {
  BASIC
  STANDARD
  PREMIUM
}

// ============ MODELS ============

model User {
  id          String   @id @default(cuid())
  phone       String   @unique  // "+919876543210" format always
  name        String?
  email       String?
  role        Role     @default(CUSTOMER)
  language    String   @default("hi")
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  profileCompleted Boolean @default(false)
  avatarUrl        String?
  preferredLanguage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerProfile    CustomerProfile?
  pandit             PanditProfile?
  bookingsAsCustomer Booking[]             @relation("CustomerBookings")
  reviewsGiven       Review[]              @relation("ReviewsGiven")
  reviewsReceived    Review[]              @relation("ReviewsReceived")
  favoritePandits    FavoritePandit[]      @relation("CustomerFavorites")
  favoritedBy        FavoritePandit[]      @relation("PanditFavorited")
  statusUpdates      BookingStatusUpdate[]
  notifications      Notification[]
  familyMembers      FamilyMember[]
  customerRatings    CustomerRating[]      @relation("CustomerRatingsReceived")

  @@index([role])
  @@index([isActive])
}

model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  preferredLanguages String[]
  gotra              String?  // Family gotra for ritual matching
  addresses          Address[]
  createdAt          DateTime @default(now())
}

model Address {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  label             String          // "Home", "Office", "Parents' House"
  fullAddress       String
  city              String
  state             String
  pincode           String
  landmark          String?
  latitude          Float?
  longitude         Float?
  isDefault         Boolean         @default(false)
}

model PanditProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  bio                  String?
  experienceYears      Int                @default(0)
  languages            String[]
  specializations      String[]           // ["Vivah", "Griha Pravesh", ...]
  // F29: poojas added after signup await video verification (P12); the
  // initial signup set is considered verified.
  pendingPoojaVerifications String[]      @default([])
  verificationStatus   VerificationStatus @default(PENDING)
  aadhaarVerified      Boolean            @default(false)
  videoKycCompleted    Boolean            @default(false)
  certificateUrls      String[]
  aadhaarFrontUrl      String?
  aadhaarBackUrl       String?
  videoKycUrl          String?
  profilePhotoUrl      String?

  location    String  // City name e.g. "Varanasi"
  fullAddress String?

  // Ratings & Stats
  rating            Float @default(0)
  totalReviews      Int   @default(0)
  completedBookings Int   @default(0)

  // 🔴 DEAD COLUMN (ruled 2026-08-03) — travelPreferences had THREE writers
  // and ZERO readers; all three writers were killed the same day (the
  // unvalidated PUT /pandits/me/travel-preferences, the /me schema key,
  // onboarding step3's write). A QUESTION NOBODY READS WAS THEATER. The
  // living vocabulary is travelPrefs/foodPrefs/accommodationPrefs below.
  // TRIPWIRE: never add a writer or reader here — the DROP rides the next
  // migration Isj runs on Neon.
  travelPreferences Json @default("{}")

  // Bank details for payouts
  bankAccountName   String?
  bankIfscCode      String?
  bankName          String?  // Auto-fetched from IFSC
  bankVerified      Boolean  @default(false)

  // 🔴 DEAD — no writer, no reader (ruled order #2, Isj 2026-08-04).
  // These two columns held THREE formats at once: base64 from two writers
  // (one of them a function literally named encrypt()), and RAW PLAINTEXT
  // from two more in routes files. Nothing ever decrypted them — they were
  // read only as slice(-4), which on a base64 row showed the last four
  // characters of BASE64 to the pandit as his own account digits.
  // TRIPWIRE: never add a writer or a reader here. The DROP rides the
  // migration after the backfill's after-count reads zero non-AES rows.
  bankAccountNumber String?
  upiId             String?

  // PAYOUT CREDENTIALS — the Aadhaar shape, exactly (ruled order #2).
  // ciphertext for the one admin-only decrypt site; the display value is
  // STORED at capture, never derived from the blob, so every "last four"
  // surface is correct by construction.
  bankAccountEncrypted String?
  bankAccountLast4     String?
  upiIdEncrypted       String?
  upiIdMasked          String?

  // Device info — auto-captured during registration, shown to customers so they know pandit is tech-equipped
  deviceOs    String?  // "Android 12", "iOS 16"
  deviceModel String?  // "Samsung Galaxy A32"
  appVersion  String?

  isOnline Boolean @default(false) // Pandit's online/offline toggle — his INTENT only
  // PRESENCE EVIDENCE (Isj's isOnline law, 2026-08-03): touched by the pandit
  // app's 30s home poll and the toggle itself. The customer-facing claim is
  // NEVER this column or isOnline alone — it is lib/presence.ts
  // effectiveOnline(isOnline, lastSeenAt): intent AND evidence within 90s.
  // AN ASSERTION BECOMES A COMPUTATION OVER FACTS.
  lastSeenAt DateTime?
  // Booking-readiness R2: null = never asked; answered in the readiness flow
  canBringSamagri Boolean?

  adminNotes           String?  @db.Text
  rejectionReason      String?  @db.Text
  // THE NEGATIVE CLAIM HAS AN AUTHOR TOO (2026-07-31). REJECTED was written
  // inline with a reason and nothing else: the platform told a real person
  // his identity was refused and kept no record of who decided it. By this
  // campaign's own law an APPROVED with no author is fabricated by
  // definition — a REJECTED with no author is the same claim in the
  // negative. Bare String?, matching verifiedById: the ops session is the
  // env-login (id "admin"), not a User row, so a FK would refuse the write.
  rejectedAt           DateTime?
  rejectedById         String?
  verifiedAt           DateTime?
  verifiedById         String?
  profileCompletionPercent Int  @default(0)

  // Newly added fields needed by kyc and voice routes
  displayName          String?
  city                 String             @default("")
  state                String?
  sect                 String?
  gotra                String?
  aadhaarEncrypted     String?
  aadhaarLastFour      String?
  aadhaarConsentAt     DateTime? // DPDP: when the pandit consented to Aadhaar processing (recorded, not just gated)
  certificatesVerified Boolean @default(false)
  bankAccountAdded     Boolean @default(false)
  deviceInfo           Json?

  pujaServices       PujaService[]

  // Spec fields:
  fullName           String              @default("")
  latitude           Float?
  longitude          Float?
  yearsExperience    Int                 @default(0)
  photoUrl           String?
  aadhaarDocUrl      String?
  teamSize           Int                 @default(1)
  bankIfsc           String?

  // Booking-readiness (progressive onboarding): registration creates an
  // ACCOUNT only; booking capabilities are earned via the resumable
  // readiness flow (R1 pujas+dakshina, R2 samagri, R3 travel, R4 food/stay,
  // R5 payment+verification).
  // travelPrefs: { ownVehicle:{enabled,maxKm}, train:{enabled,classes[]},
  //   bus:{enabled,ac}, flight:{enabled}, exclusions[], localCabOk }
  // foodPrefs: { dietary, hotelFoodOk, allergies, dailyAllowance,
  //   stayAtCustomerHome, hotelTier }
  travelPrefs        Json?
  foodPrefs          Json?
  // accommodationPrefs: { customerHomeOk, hotelTier, sharedRoomOk, advanceNoticeDays }
  accommodationPrefs Json?
  readinessStep      Int                 @default(0)
  isBookingReady     Boolean             @default(false)
  dakshinaRates      DakshinaRate[]
  samagriPackages    SamagriPackage[]    @relation("PanditSamagriRelation")
  blockedDates       BlockedDate[]
  bookings           Booking[]
  payouts            Payout[]
  customerRatings    CustomerRating[]
  poojaVerifications PoojaVerification[]
  poojaConfigs       PoojaConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([location])
  @@index([isOnline])
  @@index([rating])
}

model PujaService {
  id              String        @id @default(cuid())
  panditProfileId String
  panditProfile   PanditProfile @relation(fields: [panditProfileId], references: [id])
  // TRACK 2A: canonical value from packages/types PUJA_TYPES (e.g.
  // "GRIHA_PRAVESH"). This comment used to read `"Vivah", "Griha Pravesh" etc.`
  // while DakshinaRate.pujaType read `e.g. "SATYANARAYAN"` — two conventions
  // documented in one schema and reconciled nowhere. One vocabulary now.
  pujaType        String
  dakshinaAmount  Int           // In rupees, no decimals
  // M2: nullable. PoojaConfig — the wizard's own record — has no duration
  // field, so a wizard-written row has nothing truthful to put here.
  // Defaulting it to a constant would print an invented "2 hours" on a public
  // profile, which is the fabricated-not-empty class this campaign deletes.
  durationHours   Float?
  description     String?
  // The PUBLISH FLAG. Rows are created isActive:false and only an admin
  // approval flips them true — every customer read already filters
  // isActive:true, so an unapproved pooja is invisible rather than gated.
  isActive        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  // M1: the wizard upserts on (pandit, puja); without this the write is a
  // findFirst-then-branch that races two submits into duplicate rows.
  @@unique([panditProfileId, pujaType])
  @@index([panditProfileId])
  @@index([pujaType])
}

model DakshinaRate {
  id        String @id @default(cuid())
  panditId  String
  pandit    PanditProfile @relation(fields: [panditId], references: [id])
  pujaType  String            // e.g. "SATYANARAYAN"
  amount    Int               // rupees, integer only
  @@unique([panditId, pujaType])
}

model SamagriPackage {
  id              String        @id @default(cuid())
  packageName     String?        // "Basic", "Standard", "Premium"
  packageType     PackageType?
  pujaType        String        // Which puja this package is for
  fixedPrice      Int?           // FIXED, non-negotiable, set by pandit
  // items: JSON array of { itemName: string, quantity: string, brand: string, qualityNotes?: string }
  // Example: [{"itemName":"देसी घी","quantity":"500 ग्राम","brand":"अमूल","qualityNotes":"गाय का शुद्ध घी"}]
  //
  // F12-02 — brand/company is REQUIRED-ON-WRITE, OPTIONAL-ON-READ. Rows written
  // before F12-02 have no brand key; because this is a Json column there was no
  // migration to backfill them, and we will not invent a company name that a
  // pandit never gave. Read them through readSamagriItems() (brand → null) and
  // never assume the key is present. "कोई भी" is the real answer for an item
  // where no company binds — it is a value, not an absence.
  // THE SHAPE IS DEFINED ONCE: services/api/src/lib/samagriItem.ts.
  items    Json
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  // Spec fields:
  panditId        String         @default("")
  pandit          PanditProfile  @relation("PanditSamagriRelation", fields: [panditId], references: [id])
  tier            PackageTier    @default(BASIC)
  price           Int            @default(0)

  @@index([panditId])
  @@unique([panditId, pujaType, tier])
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

// ── सत्यापन (verification) spine ──────────────────────────────────────────────

enum VideoProvider {
  YOUTUBE
  UPLOAD
}

enum PoojaVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SamagriSupplyMode {
  PANDIT_BRINGS   // pandit brings the samagri; per-tier prices apply
  PLATFORM_SELLS  // platform sells + delivers
  LIST_ONLY       // just a list; customer arranges
}

/// One row PER SUBMISSION — history is NEVER overwritten. A re-submit inserts a
/// new row with version+1 and status PENDING; a rejection stays in history with
/// its reason. The EFFECTIVE state for a (pandit, poojaType) is the highest
/// version. The per-puja booking GATE requires that latest row to be APPROVED.
model PoojaVerification {
  id              String   @id @default(cuid())
  panditProfileId String
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id])
  poojaType       String
  // custom pujas: the pandit's own name + description (admin-approved too)
  poojaName       String?
  poojaDescription String? @db.Text
  videoProvider   VideoProvider           @default(YOUTUBE)
  videoUrl        String?  // raw link the pandit gave (YouTube unlisted)
  videoId         String?  // parsed YouTube id
  thumbnailUrl    String?  // kept for later customer playback (deferred, zero-migration)
  publicUrl       String?  // kept for later customer playback (deferred, zero-migration)
  status          PoojaVerificationStatus @default(PENDING)
  rejectionReason String?  @db.Text
  version         Int      @default(1)
  consentAt       DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([panditProfileId, poojaType, version])
  @@index([status])
}

/// Per-puja team + dakshina + samagri supply mode. The team's dakshina share is
/// INCLUDED in dakshinaAmount (the single-payee law: the platform never pays the
/// team — the main pandit does).
model PoojaConfig {
  id              String   @id @default(cuid())
  panditProfileId String
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id])
  poojaType       String
  teamSize        Int      @default(1)  // incl. the main pandit
  dakshinaAmount  Int      @default(0)  // total dakshina, team share included
  supplyMode      SamagriSupplyMode @default(PANDIT_BRINGS)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([panditProfileId, poojaType])
}

model BlockedDate {
  id       String   @id @default(cuid())
  panditId String
  pandit   PanditProfile @relation(fields: [panditId], references: [id])
  date     DateTime          // date only, time 00:00 UTC
  reason   String?
  @@unique([panditId, date])
  @@index([date])
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique // "HPJ-2026-ABC12"

  customerId String
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id])
  
  status BookingStatus @default(REQUESTED)

  // Event details
  eventType        String   // "Vivah", "Griha Pravesh" etc.
  eventDate        DateTime
  eventEndDate     DateTime? // For multi-day events like Vivah
  completedAt      DateTime? // When booking was marked COMPLETED
  muhuratTime      String?   // "10:30 AM - 12:00 PM"
  muhuratSuggested Boolean   @default(false)

  // Venue
  venueAddress        String
  venueCity           String
  venuePincode        String
  venueLatitude       Float?
  venueLongitude      Float?
  attendees           Int?
  specialInstructions String?

  // Travel
  travelRequired   Boolean      @default(false)
  travelMode       TravelMode?
  travelDistanceKm Float?
  travelStatus         TravelStatus @default(NOT_REQUIRED)
  travelBookingRef     String?      // Admin manually enters IRCTC/MMT reference
  travelNotes          String?
  calculatedTravelCost Int?
  travelBreakdown      Json?
  travelBookingDetails Json?
  travelDocumentUrls   String[]

  // Food & Accommodation
  foodArrangement          FoodArrangement          @default(CUSTOMER_PROVIDES)
  foodAllowanceDays        Int                      @default(0)
  foodAllowanceAmount      Int                      @default(0) // foodAllowanceDays * 1000
  accommodationArrangement AccommodationArrangement @default(NOT_NEEDED)
  accommodationCost        Int                      @default(0)

  // Samagri
  samagriPreference SamagriPreference @default(PANDIT_BRINGS)
  samagriPackageId  String?           // If PANDIT_BRINGS and chose a fixed package
  samagriCustomList Json?             // If PANDIT_BRINGS with custom list or NEED_HELP
  samagriAmount     Int               @default(0)
  samagriNotes      String?

  // Pricing — ALL amounts stored in rupees (integers, no decimals)
  dakshinaAmount      Int @default(0)
  travelCost          Int @default(0)
  // RULING B (Isj, 2026-07-28): the fee is charged to the CUSTOMER on top of
  // the dakshina and NEVER reduces the payout. The old "15% of dakshina" and
  // "dakshina - platformFee" notes below described a deducted model that no
  // longer exists in the code or in the ruling; corrected rather than left to
  // contradict.
  platformFee         Int @default(0)  // PLATFORM_FEE_PERCENT of dakshina, customer-paid, ON TOP
  // THE SNAPSHOT INVARIANT: the rate in force WHEN THIS BOOKING WAS CREATED.
  // Ops may change the default at any time; a booking's arithmetic must never
  // move underneath it. Every downstream figure — payout, receipt, admin
  // total, earnings, conservation check — reads THIS, never the live default.
  platformFeePercent  Int @default(10) // frozen at creation; see feeSnapshot.ts
  platformFeeGst      Int @default(0)  // GST on the FEE only — never on the dakshina
  travelServiceFee    Int @default(0)  // 5% of travelCost
  travelServiceFeeGst Int @default(0)  // 18% of travelServiceFee
  grandTotal          Int @default(0)  // dakshina + platformFee + pass-throughs

  // Pandit payout
  // RENAMED (Isj ruling 2026-07-28) so the name says WHICH money it is.
  // `platformTransfersToPandit` = what WE send him. Its sibling,
  // `panditReceivesTotal` (lib/earnings.ts), = everything that reaches him
  // from any hand, including the samagri he collects himself. The two differ
  // by exactly samagriAmount, and sharing an indistinct name is precisely how
  // the samagri bug happened.
  // @map keeps the physical column "panditPayout" — no data migration.
  platformTransfersToPandit Int      @default(0) @map("panditPayout") // dakshina + travel + food + accommodation — the fee is NOT deducted
  payoutStatus      PayoutStatus @default(PENDING)
  payoutReference   String?
  payoutCompletedAt DateTime?

  // Cancellation
  cancelledBy             String?      // "CUSTOMER" | "PANDIT" | "ADMIN"
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  cancelledAt             DateTime?
  adminNotes              String?      @db.Text
  refundAmount            Int          @default(0)
  refundStatus            RefundStatus @default(NONE)
  refundReference         String?

  // Payment
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     PaymentStatus @default(PENDING)

  // Spec fields:
  panditId        String         @default("")
  pandit          PanditProfile  @relation(fields: [panditId], references: [id])
  customerName    String         @default("")
  customerPhone   String         @default("")
  pujaType        String         @default("")
  eventAddress    String         @default("")
  travelAmount    Int            @default(0)
  foodAllowance   Int            @default(0)
  journeyStep     Int            @default(0)
  acceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusUpdates BookingStatusUpdate[]
  review        Review?
  payout        Payout?
  customerRating CustomerRating?

  @@index([customerId])
  @@index([panditId])
  @@index([status])
  @@index([eventDate])
  @@index([bookingNumber])
  @@index([paymentStatus])
}

model BookingStatusUpdate {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])
  fromStatus  BookingStatus
  toStatus    BookingStatus
  updatedById String
  updatedBy   User          @relation(fields: [updatedById], references: [id])
  note        String?
  latitude    Float?        // Pandit's GPS when tapping "I'm Here" buttons
  longitude   Float?
  createdAt   DateTime      @default(now())

  @@index([bookingId])
}

model Review {
  id                   String   @id @default(cuid())
  bookingId            String   @unique
  booking              Booking  @relation(fields: [bookingId], references: [id])
  reviewerId           String
  reviewer             User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId           String
  reviewee             User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  overallRating        Float    // 1.0 to 5.0
  knowledgeRating      Float?
  punctualityRating    Float?
  communicationRating  Float?
  valueForMoneyRating  Float?
  comment              String?
  photoUrls            String[]
  isAnonymous          Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([revieweeId])
}

model FavoritePandit {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerFavorites", fields: [customerId], references: [id])
  // RENAMED IN CODE ONLY (Isj ruling 2026-07-31, Option A). Six models carry
  // `panditId`; the other five hold a PanditProfile id — this one alone holds
  // a USER id, and that lie produced a two-space hedge in a production delete
  // script. The FIELD now says what it holds; the COLUMN keeps its historic
  // name via @map, so raw SQL still says "panditId" — that surface is covered
  // by the id-space check in sqlDocIdentifiers.test.ts. Two surfaces, two
  // instruments, zero swap window.
  panditUserId String @map("panditId")
  pandit       User   @relation("PanditFavorited", fields: [panditUserId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([customerId, panditUserId])
  @@index([customerId])
}

model MuhuratDate {
  id           String   @id @default(cuid())
  date         DateTime
  pujaType     String   // "Vivah", "Griha Pravesh" etc.
  timeWindow   String   // "10:30 AM - 12:00 PM"
  significance String?  // "Akshaya Tritiya — highly auspicious for new beginnings"
  source       String   // "Hindu Panchang 2026"

  @@index([date])
  @@index([pujaType])
  @@unique([date, pujaType, timeWindow])
}

model CityDistance {
  id                  String @id @default(cuid())
  fromCity            String
  toCity              String
  distanceKm          Float
  estimatedDriveHours Float?

  @@unique([fromCity, toCity])
  @@index([fromCity])
}

model SupportTicket {
  id               String   @id @default(cuid())
  source           String
  type             String
  subject          String
  description      String   @db.Text
  priority         String   @default("MEDIUM")
  status           String   @default("OPEN")
  relatedBookingId String?
  relatedUserId    String?
  resolution       String?  @db.Text
  createdBy        String   // admin who logged it
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([priority])
}

model FamilyMember {
  id        String    @id @default(cuid())
  userId    String
  name      String
  relation  String
  dob       DateTime?
  nakshatra String?
  rashi     String?
  user      User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // BOOKING, TRAVEL, STATUS, PAYMENT, REVIEW, SYSTEM
  title     String
  message   String
  data      Json?    // { bookingId?, panditId?, etc. }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model CustomerRating {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  panditId        String
  customerId      String
  // Same shape as Payout above: three bare ids with no integrity. Riding along
  // because the cost is identical on an empty table and a rating attached to a
  // deleted booking is the same class of silent orphan.
  booking         Booking       @relation(fields: [bookingId], references: [id])
  pandit          PanditProfile @relation(fields: [panditId], references: [id])
  customer        User          @relation("CustomerRatingsReceived", fields: [customerId], references: [id])
  punctuality     Int      // 1-5
  hospitality     Int      // 1-5
  foodArrangement Int      // 1-5
  comment         String?
  createdAt       DateTime @default(now())
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model AdminLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Ritual {
  id               String   @id @default(cuid())
  name             String
  nameHindi        String?
  description      String?
  descriptionHindi String?
  category         String?
  basePriceMin     Int?
  basePriceMax     Int?
  durationHours    Float?
  isActive         Boolean  @default(true)
  iconUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PanditMilestone {
  id         String    @id @default(cuid())
  panditId   String    // PanditProfile.id
  kind       String    // FIRST_BOOKING | BOOKINGS_5 | BOOKINGS_11 | BOOKINGS_21 | BOOKINGS_51 | EARNED_11K | EARNED_51K | EARNED_1L | PROFILE_COMPLETE
  achievedAt DateTime  @default(now())
  seenAt     DateTime? // null until the pandit app has shown the celebration

  @@unique([panditId, kind])
  @@index([panditId])
}

model Payout {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  panditId   String
  // FOREIGN KEYS ADDED 2026-07-28 (Isj ruling). These were bare String columns
  // with no referential integrity, so the schema permanently permitted an
  // ORPHANED PAYOUT — a money record pointing at a booking that does not
  // exist. admin.routes.ts:222 creates a Payout ON DEMAND inside mark-paid if
  // none is found, so a stale bookingId minted money attached to nothing and
  // the database never objected. Added on an empty table, where the orphan
  // check is free.
  booking    Booking       @relation(fields: [bookingId], references: [id])
  pandit     PanditProfile @relation(fields: [panditId], references: [id])
  // RULING B: 100% of dakshina + pass-throughs. The fee is NEVER deducted.
  // (The previous note here read "dakshina - platformFee + …" — Model A prose
  // surviving in the storage layer, which is a contract surface.)
  amount     Int
  status     PayoutStatus @default(PENDING)   // enum: PENDING | PAID
  createdAt  DateTime @default(now())
  paidAt     DateTime?
}

// S6d: शिष्य brain-miss telemetry — every question the brain could not
// answer, verbatim. This table IS the curation queue for brain v2.
model FeedbackUnanswered {
  id        String   @id @default(cuid())
  text      String   // the pandit's question, verbatim (≤300 chars client-side)
  route     String   // app route where it was asked
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// W2: every agent exchange, verbatim — telemetry + the curation corpus
// for prompt iteration. Supersedes FeedbackUnanswered for agent traffic
// (that table keeps serving reflex-layer brain misses).
model ShishyaExchange {
  id        String   @id @default(cuid())
  text      String   // the pandit's utterance
  say       String   // what shishya answered
  act       String?  // executed tool id, if any
  route     String
  lang      String   @default("hi")
  ms        Int      @default(0)
  model     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
